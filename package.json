{
  "name": "proyecto",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "postbuild": "node -e \"const fs=require('fs'); const src='dist/proyecto/browser/index.html'; const dest='dist/proyecto/browser/404.html'; if(fs.existsSync(src)) fs.copyFileSync(src, dest);\"",
    "test": "ng test --watch=false",
    "build:production": "ng build --configuration production --base-href /NATOS/ && node scripts/postbuild.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve-preview.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-browser-dynamic": "^22.0.8",
    "@angular/router": "^22.0.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.9",
    "@angular/cli": "^22.0.9",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
